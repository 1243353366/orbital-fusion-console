{
  "name": "orbital-fusion-console",
  "private": true,
  "version": "0.2.1",
  "description": "Sentinel Atlas v0.2.1 Release Hardening: provenance-aware mapping, consent-based browser review, and hash-first artifact verification.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=25.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "release:pack": "npm run build && node scripts/package-release.mjs",
    "scan:file": "node tools/sentinel-scan.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:security-site": "node scripts/test-security-site.mjs",
    "test:extension": "node scripts/validate-extension.mjs",
    "test:security-boundaries": "node scripts/validate-security-boundaries.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "puppeteer-core": "^25.11.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
